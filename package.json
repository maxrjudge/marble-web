{
  "name": "marble-web",
  "version": "0.1.0",
  "description": "MarbleArena-Website: Livebild aus LSM, Chat mit Twitch-Brücke, Anmeldung, Anbindung an die Murmel-Arena",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "dev": "tsx watch server/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module"
}
