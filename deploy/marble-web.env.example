# Vorlage für /etc/marble-web.env (auf dem Server anlegen, NICHT ins Git, NICHT in den Chat):
#   sudo cp deploy/marble-web.env.example /etc/marble-web.env
#   sudo chmod 600 /etc/marble-web.env && sudo chown root:root /etc/marble-web.env
#   sudo nano /etc/marble-web.env      (Werte eintragen)
# Fehlt etwas, steht es beim Start im Log (journalctl -u marble-web) und auf /admin.

BASE_URL=https://arena.maxr.at
HOST=127.0.0.1
PORT=5310
DB_PATH=/var/lib/marble-web/marble-web.db

# Livebild aus LSM: Stream-Schlüssel aus „Teilen & Einbetten“ (https://io.maxr.at/livestream/<schlüssel>/)
LSM_EMBED_BASE=https://io.maxr.at/embed/live/
LSM_STREAM_KEY=

# Twitch-App (dev.twitch.tv › Console › Anwendungen), OAuth-Redirect: https://arena.maxr.at/auth/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=marblearena

# Anmeldung per E-Mail (Link ohne Passwort). Port 465 = SSL, 587 = STARTTLS (dann SMTP_SECURE=false)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MarbleArena <noreply@maxr.at>

# Die Arena meldet sich damit an (&seitentoken=… in der Arena-Adresse). Mindestens 16 Zeichen, z. B.:
#   openssl rand -hex 24
ARENA_TOKEN=

# /admin (Benutzer „admin“), mindestens 10 Zeichen
ADMIN_PASSWORD=
